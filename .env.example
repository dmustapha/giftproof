# GiftProof environment (server-side only: NEVER expose these in the client bundle).
# Copy to .env.local for local dev, or set in the VM env for production.

# ── Qloo (REQUIRED for live calls; app runs in fixture-mode without it) ─────────
# Hackathon-tenant key, emailed after the Qloo Devpost API form. Header is X-Api-Key.
QLOO_API_KEY=
# Constant: the hackathon tenant. Dev/console keys do NOT work here.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ── LLM: 0G Compute Router (REQUIRED: the SOLE path for taste extraction + narration) ──
# No-fallback directive (2026-10-29): 0G is the only LLM path. There is NO template/alias
# fallback. If 0G is unreachable the app degrades HONESTLY (EXTRACTION_UNAVAILABLE token,
# narration:null) and the Qloo-ranked grid still renders; it never fakes agentic output.
# Qloo ALWAYS ranks (NN-1); the LLM never ranks.
ZEROG_COMPUTE_API_KEY=
ZEROG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
# OpenAI-compatible model on the 0G router (gemini-2.5-flash validated for extraction+narration).
LLM_MODEL=gemini-2.5-flash

# ── Deploy (set by deploy.sh / the VM) ──────────────────────────────────────────
GIT_SHA=

# ── Action Option-B (OPTIONAL: Tremendous sandbox; Option-A buy-link is baseline)
TREMENDOUS_SANDBOX_KEY=
TREMENDOUS_FUNDING_ID=
